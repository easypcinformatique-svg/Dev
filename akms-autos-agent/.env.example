# Cle API Claude (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Jeton pour lire les rendez-vous / demandes : openssl rand -hex 32
AKMS_ADMIN_TOKEN=changez-moi
# Domaines autorises a integrer le widget (separes par des virgules)
AKMS_ALLOWED_ORIGINS=https://www.akms-autos.fr
# Optionnel
AKMS_MODEL=claude-opus-5-5
AKMS_EFFORT=medium
AKMS_RATE_PER_MIN=20
